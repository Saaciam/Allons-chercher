# Adresse du compte qui envoie les emails ; à renseigner dans .env.
EMAIL_ADDRESS=
# Mot de passe d'application SMTP ; ne jamais le placer dans Git.
EMAIL_PASSWORD=
# Identité de Christopher (également disponible dans candidate_profile.json).
SENDER_PRENOM=Christopher Isaac William
SENDER_NOM=KOUTOUA
SENDER_TELEPHONE=+33 7 53 26 00 25
# Serveur SMTP et port STARTTLS.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
# Clé API Hunter pour rechercher les contacts.
HUNTER_API_KEY=

# Facultatif : recherche d'offres avec France Travail.
# Accès API restreint : demander l'accès via https://francetravail.io/contact.
# Des identifiants d'application déjà autorisée peuvent être saisis dans l'interface.
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
